{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aimdock",
  "version": "0.1.0",
  "identifier": "com.aimdock.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "aimdock",
        "width": 900,
        "height": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
